# Ad-hoc UI exploration artifacts (see /verify-ui skill)
ui_exploration/

# Node / Electron — the console shell's dependency tree is installed, never
# committed (src/vpath_platform_mgmt/console/electron/)
# package-lock.json is deliberately NOT ignored: it pins the transitive tree,
# which is the only supply-chain guarantee the Node side has.
node_modules/
npm-debug.log*

# Java / Gradle (flavor branches generate these when switching locally)
build/
.gradle/
*.class

# Claude agent memories are machine-local; committing them in the template
# would propagate them into every derived project on sync
.claude/agent-memory/

# Instance credentials and access material — never commit
# (see docs/INSTANCES.md and analysis/instance-management/)
platform-admin-credentials*.zip
*.pem
*_key
*_key.*
# THE instance register. Its template (instances.example.env) is tracked and
# carries placeholders only; the filled-in file never is.
instances.local.*
