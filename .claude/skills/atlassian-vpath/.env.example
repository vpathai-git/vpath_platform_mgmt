# Credentials for this skill's Confluence publishing.
# Create a .env with these values - in the WORKING DIRECTORY (repo root, where you
# start Claude / the scripts) OR in this skill folder. Alternatively export them as
# environment variables (these take precedence). NEVER commit it.
#
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens

API_Token_Confluence = your-atlassian-api-token
Atlassian_Email      = you@example.com
Confluence_Base_URL  = https://your-team.atlassian.net/
