# =============================================================================
# instances.example.env -- template for the platform instance register
# =============================================================================
# Copy this file to `instances.local.env` next to it and fill in your own
# environments.  That file is gitignored and MUST stay that way: it carries
# addresses, user names and key paths.  This template carries none.
#
#     cp instances.example.env instances.local.env
#     $EDITOR instances.local.env
#     python -m vpath_platform_mgmt.instances.selector list
#
# Where the register may live, in this order:
#   1. --register <path>
#   2. $VPATH_INSTANCES_FILE
#   3. <repo root>/instances.local.env
# There is no fourth option and no built-in default instance.
#
# FORMAT
#   KEY=VALUE, one per line.  `#` starts a comment ONLY at the start of a line
#   -- exactly like the server's config/dot_env profiles, which are guarded
#   against inline comments for the same reason: a `#` inside a value is
#   otherwise ambiguous.  `~` and `$HOME` are expanded in path fields.
#
# THE BOUNDARY -- read this before adding a field
#   The register says WHERE an environment is and FROM WHERE it is driven.
#   It never says HOW the platform is built, installed or deployed: that is the
#   server project's pipeline.  Ports, workspace paths and target directories
#   are NOT recorded here -- they are read from the box's own env profile
#   (config/dot_env/.env.<profile>) when they are needed, so each of them keeps
#   exactly one home.  Copying a value out of that profile into this file
#   creates a second variant of it, and the two will drift.
#
# NAMING (two classes, decided 2026-07-27)
#   Server environments carry planet names in acquisition order: mercury8,
#   venus10, terra, then mars, jupiter, ...  The numeric suffix is the NUC
#   generation; a cloud VM has none.
#   Standalone environments carry NATO alphabet names: alpha, bravo, ...
# =============================================================================

# Every instance that exists, whitespace-separated, in the order you want them
# listed.  A name not in this line is not read, even if its fields are present.
VPATH_INSTANCES=mercury8 venus10 terra alpha bravo

# --- fields, per kind --------------------------------------------------------
# All instances:
#   <NAME>_KIND        server-nuc | server-cloud-vm | standalone | remote
#                      (required; remote is declared/unproven — live ops refused)
# Kind field requirements also live in
# src/vpath_platform_mgmt/instances/templates/<kind>.yaml
#   <NAME>_LIFECYCLE   live | planned         (default: live)
#   <NAME>_NOTES         free text, one line
#   <NAME>_ONTOGATE_URL  optional OntoGate UI link (absent = "not available")
#
# server-nuc / server-cloud-vm (required unless LIFECYCLE=planned):
#   <NAME>_SSH_HOST        address the dev machine connects to
#   <NAME>_SSH_USER        login user on the box
#   <NAME>_SSH_KEY         private key path; omit to use the ssh default
#   <NAME>_SSH_KEY_SOURCE  where to get the key if it is not materialised yet
#   <NAME>_SSH_ALIAS       ~/.ssh/config alias, informational
#   <NAME>_ENV_PROFILE     server env profile name -> ./gradlew -Penv=<this>
#   <NAME>_CHECKOUT        the server checkout ON the box: delivery target and
#                          the working directory Gradle is started in
#   <NAME>_SOURCE_CHECKOUT the server checkout ON THIS MACHINE that `deliver`
#                          reads the commit from.  Required for `deliver`; git
#                          would otherwise resolve the sha against the directory
#                          the command happens to run in and push nothing
#                          ("fatal: bad object" / "remote unpack failed").
#
# standalone (required unless LIFECYCLE=planned):
#   <NAME>_APP_ROOT        the app repository carrying the Electron shell
#   <NAME>_HOME            VPATH_STANDALONE_HOME -- runtime state, keys, KPs
# -----------------------------------------------------------------------------

# --- server environment on a NUC ---------------------------------------------
MERCURY8_KIND=server-nuc
MERCURY8_SSH_HOST=<lan-address-of-the-box>
MERCURY8_SSH_USER=<box-user>
MERCURY8_SSH_KEY=$HOME/.ssh/<key-file>
MERCURY8_SSH_ALIAS=mercury8
MERCURY8_ENV_PROFILE=nuc
MERCURY8_CHECKOUT=<path-of-the-server-checkout-on-the-box>
MERCURY8_SOURCE_CHECKOUT=<path-of-the-server-checkout-on-this-machine>
MERCURY8_NOTES=first NUC; carries the CUDA eGPU

VENUS10_KIND=server-nuc
VENUS10_SSH_HOST=<lan-address-of-the-box>
VENUS10_SSH_USER=<box-user>
VENUS10_SSH_KEY=$HOME/.ssh/<key-file>
VENUS10_SSH_ALIAS=venus10
VENUS10_ENV_PROFILE=nuc
VENUS10_CHECKOUT=<path-of-the-server-checkout-on-the-box>
VENUS10_SOURCE_CHECKOUT=<path-of-the-server-checkout-on-this-machine>
VENUS10_NOTES=second NUC

# --- server environment on a cloud VM ----------------------------------------
# Same shape as a NUC: what differs is the env profile it is driven with and
# the fact that the key usually has to be materialised out of a credentials
# bundle first.  SSH_KEY_SOURCE is what the tooling tells you to extract when
# the key path does not exist -- it never falls back to another key.
TERRA_KIND=server-cloud-vm
TERRA_SSH_HOST=<public-address-of-the-vm>
TERRA_SSH_USER=<vm-user>
TERRA_SSH_KEY=$HOME/.ssh/<key-file>
TERRA_SSH_KEY_SOURCE=<credentials-bundle>::<member-name>
TERRA_ENV_PROFILE=vm5
TERRA_CHECKOUT=<path-of-the-server-checkout-on-the-box>
TERRA_SOURCE_CHECKOUT=<path-of-the-server-checkout-on-this-machine>
TERRA_NOTES=cloud VM; nothing exposed to the internet by design

# --- standalone environment --------------------------------------------------
ALPHA_KIND=standalone
ALPHA_APP_ROOT=<path-of-the-app-repo-with-the-electron-shell>
ALPHA_HOME=<path-of-VPATH_STANDALONE_HOME>
ALPHA_NOTES=first standalone

# A name that is agreed but not built yet.  Declaring it costs nothing and the
# probe reports it as PLANNED rather than as a failure -- but if it turns out
# to exist after all, that is reported as register drift.
BRAVO_KIND=standalone
BRAVO_LIFECYCLE=planned
BRAVO_NOTES=second standalone, to be built
