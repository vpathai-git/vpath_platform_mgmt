# Console instance profile — template.
#
# Copy to `.env.<instance>` (e.g. `.env.vm5`) and fill in that instance's
# values, then start the console with:
#
#     ./venv/Scripts/vpath-console.exe --instance vm5
#
# `.env.<instance>` is gitignored; this template carries placeholders only.
# Real environment variables still win over anything set here.
#
# Addresses below are the vm5 topology (see .claude/skills/vm5-access) and
# assume the operator's SOCKS tunnel is up — nothing here is reachable from
# the open internet.
#
# 10.0.0.4 has NO direct route from a workstation: connect-vm5.ps1 opens a
# SOCKS proxy (-D 127.0.0.1:1085) and no -L forwards, so the console's HTTP
# clients must be pointed through it or every call hangs until it times out.
# ALL_PROXY below does that; httpx needs the `socksio` package to honour it
# (`pip install socksio`). Running the console ON the box needs neither.

# --- which instance, and how verbs execute --------------------------------
VPATH_MGMT_INSTANCE=vm5
VPATH_MGMT_ENGINE=gitops

# The Deploy-of-Record. A deploy is a commit here, reconciled by ArgoCD.
VPATH_MGMT_GITEA_URL=https://10.0.0.4:30600/gitea
VPATH_MGMT_GITEA_TOKEN=REPLACE_WITH_GITEA_TOKEN

# The cluster, read to observe reconciliation.
VPATH_MGMT_K8S_URL=https://10.0.0.4:6443
VPATH_MGMT_K8S_TOKEN=REPLACE_WITH_KUBERNETES_TOKEN

# The platform serves a self-signed certificate; set deliberately, never
# inherited. Remove both INSECURE_TLS lines once real certificates land.
VPATH_MGMT_INSECURE_TLS=1

# --- who may drive it -----------------------------------------------------
# Header-trust `dev` auth is refused with a real engine, so a real instance
# always needs OIDC. The console relays Keycloak on its own origin, which is
# why the `vpath-console` client is registered with http://127.0.0.1:* .
VPATH_MGMT_AUTH=oidc
VPATH_MGMT_OIDC_ISSUER=https://10.0.0.4:30600/keycloak/realms/vpath
VPATH_MGMT_OIDC_BROWSER_ISSUER=http://127.0.0.1:8765/keycloak/realms/vpath
VPATH_MGMT_OIDC_CLIENT_ID=vpath-console
VPATH_MGMT_OIDC_INSECURE_TLS=1
VPATH_MGMT_KC_PROXY_UPSTREAM=https://10.0.0.4:30600/keycloak
VPATH_MGMT_KC_PROXY_PUBLIC=http://127.0.0.1:8765/keycloak

# --- routing --------------------------------------------------------------
# Only needed from a workstation reaching the box through the SSH tunnel.
ALL_PROXY=socks5://127.0.0.1:1085

# With these four set, the console's "Start tunnel" button can open the proxy
# above itself (admin only, audited). Leave them out and the console still
# reports a missing route — it just cannot fix it for you.
VPATH_MGMT_SSH_HOST=20.86.32.146
VPATH_MGMT_SSH_USER=azureuser
VPATH_MGMT_SSH_KEY=REPLACE_WITH_PATH_TO_YOUR_PRIVATE_KEY
VPATH_MGMT_TUNNEL_PORT=1085

# --- optional -------------------------------------------------------------
# Lets the Application Explorer open apps on the platform.
VPATH_MGMT_PLATFORM_URL=https://10.0.0.4:30600
